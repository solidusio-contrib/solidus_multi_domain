<%= render 'spree/admin/shared/configuration_menu' %>

<% admin_breadcrumb(link_to(plural_resource_name(Spree::Store), admin_stores_path)) %>
<% admin_breadcrumb(t('spree.new_store')) %>

<% content_for :page_actions do %>
  <li>
    <%= link_to I18n.t('spree.back_to_store_list'), spree.admin_stores_path, class: 'btn btn-primary' %>
  </li>
<% end %>

<div data-hook="admin_store_new_form">
  <%= form_for [:admin, @store], :html => {:multipart => true}  do |f| %>
    <fieldset class="no-border-top">
      <%= render 'form', f: f %>

      <div data-hook="admin_store_new_form_buttons">
        <%= render 'spree/admin/shared/new_resource_links' %>
      </div>
    </fieldset>
  <% end %>
</div>
