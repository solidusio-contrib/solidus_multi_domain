<%= render 'spree/admin/shared/configuration_menu' %>

<% admin_breadcrumb(link_to(plural_resource_name(Spree::Store), admin_stores_path)) %>
<% admin_breadcrumb(t('spree.editing_store')) %>

<% content_for :page_actions do %>
  <li>
    <%= link_to t('spree.back_to_store_list'), spree.admin_stores_path, class: 'btn btn-primary' %>
  </li>
<% end %>

<div data-hook="admin_store_edit_form">
  <%= form_for [:admin, @store], html: {multipart: true} do |f| %>
    <fieldset class="no-border-top">
      <%= render 'form', f: f %>
      <% if can? :update, @store %>
        <%= render 'spree/admin/shared/edit_resource_links' %>
      <% end %>
    </fieldset>
  <% end %>
</div>
