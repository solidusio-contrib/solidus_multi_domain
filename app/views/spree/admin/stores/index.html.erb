<%= render 'spree/admin/shared/configuration_menu' %>

<% content_for :page_title do %>
  <%= I18n.t('spree.stores') %>
<% end %>

<% content_for :page_actions do %>
  <% if can?(:create, Spree::Store) %>
    <li>
      <%= link_to t('spree.new_store'), new_admin_store_url, class: 'btn btn-primary' %>
    </li>
  <% end %>
<% end %>

<table class="index">
  <thead>
    <tr>
      <th><%= I18n.t('spree.logo') %></th>
      <th><%= I18n.t('spree.store_name') %></th>
      <th><%= I18n.t('spree.store_code') %></th>
      <th><%= I18n.t('spree.send_mails_as') %></th>
      <th><%= I18n.t('spree.domains') %></th>
      <th class="actions"></th>
    </tr>
  </thead>
  <tbody>
    <% @stores.each do |store| %>
      <tr>
        <td><%= image_tag store.logo.url(:mini) %></td>
        <td>
          <%= store.name %>
          <% if store.default? %>
            <span class="pill pill-default"><%= Spree::Store.human_attribute_name(:default) %></span>
          <% end %>
        </td>
        <td><%= store.code %></td>
        <td><%= store.mail_from_address %></td>
        <td><%= store.url %></td>
        <td class="actions">
          <% if can?(:update, store) %>
            <%= link_to_edit store, no_text: true %>
          <% end %>
          <% if can?(:destroy, store) %>
            <%= link_to_delete store, no_text: true %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
